# Scapy AI Analyzer environment template.
#
# Copy to .env and fill in values as needed. Never commit the filled file.
# The application reads this variable directly from the environment; it does not
# load .env files by itself, so export it in your shell or use a runner that does.

# API key for the OpenAI-compatible provider.
# Leave unset when using the default mock provider.
# SCAPY_AI_API_KEY=

# Optional: point the OpenAI-compatible provider at a different endpoint.
# SCAPY_AI_BASE_URL=https://api.openai.com/v1

# Optional: default model when --model is not given.
# SCAPY_AI_MODEL=
